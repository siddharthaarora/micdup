{
  "version": 6,
  "configurePresets": [
    {
      "name": "release-cpu",
      "displayName": "Release (CPU only)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/release-cpu",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MICDUP_VULKAN": "OFF",
        "MICDUP_CUDA": "OFF"
      }
    },
    {
      "name": "release-vulkan",
      "displayName": "Release (Vulkan GPU)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/release-vulkan",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MICDUP_VULKAN": "ON",
        "MICDUP_CUDA": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (CPU only)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICDUP_VULKAN": "OFF",
        "MICDUP_CUDA": "OFF"
      }
    },
    {
      "name": "release-mac",
      "displayName": "Release (macOS with Metal)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release-mac",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MICDUP_METAL": "ON"
      }
    },
    {
      "name": "debug-mac",
      "displayName": "Debug (macOS)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug-mac",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICDUP_METAL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-cpu",
      "configurePreset": "release-cpu",
      "configuration": "Release"
    },
    {
      "name": "release-vulkan",
      "configurePreset": "release-vulkan",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release-mac",
      "configurePreset": "release-mac",
      "configuration": "Release"
    },
    {
      "name": "debug-mac",
      "configurePreset": "debug-mac",
      "configuration": "Debug"
    }
  ]
}
